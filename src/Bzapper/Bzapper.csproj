<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <AssemblyName>Bzapper</AssemblyName>
    <RootNamespace>Bzapper</RootNamespace>

    <!-- Pacote NuGet. A versão existe aqui E em BzapperClient.Version (BzapperClient.Version.cs); o
         scripts/release-sdks.sh bumpa as duas e a suíte de testes trava que sejam iguais. -->
    <PackageId>Bzapper</PackageId>
    <Version>0.9.4</Version>
    <Authors>Berni Software</Authors>
    <Company>Berni Software</Company>
    <Product>bZapper</Product>
    <Copyright>Copyright (c) Berni Software</Copyright>
    <Description>SDK oficial .NET da API do bZapper (WhatsApp): mensagens de todos os tipos, números e QR, grupos, conversas, contatos, campanhas, webhooks (com verificação de assinatura) e bZapper Connect. Novas tentativas com idempotência, erros tipados, zero dependências além do System.Text.Json.</Description>
    <PackageTags>bzapper;whatsapp;sdk;api;messaging;webhooks;berni</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/bernisoftware/bzapper-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bernisoftware/bzapper-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Única dependência de runtime, e só no alvo netstandard2.0 (no net8.0 ela já vem com o runtime). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bzapper.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
